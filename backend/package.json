{
  "name": "aplikasi-purimas-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend Portal Purimas Tirtajaya - database Google Spreadsheet (PGlite) & berkas Google Drive",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/database', {recursive: true}); fs.copyFileSync('src/database/schema.sql', 'dist/database/schema.sql'); fs.copyFileSync('src/database/seed.sql', 'dist/database/seed.sql');\"",
    "start": "node dist/index.js",
    "db:init": "tsx src/database/initDb.ts",
    "google:auth": "tsx src/scripts/googleAuth.ts",
    "db:provision": "tsx src/database/provisionReal.ts",
    "db:import-2026-11-07": "tsx src/database/importReport2026.ts",
    "db:import-iuran-2026-11-16": "tsx src/database/importIuran20261116.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@googleapis/drive": "^27.1.0",
    "@googleapis/sheets": "^18.1.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
