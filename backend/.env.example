# Port Aplikasi
PORT=3000
NODE_ENV=production

# Kunci JWT acak, minimal 32 byte (produksi menolak kunci pendek/mudah ditebak)
JWT_SECRET=

# =============================================================================
# DATABASE: Google Spreadsheet  |  BERKAS PRIVAT (KTP/KK/bukti): Google Drive
# =============================================================================
DB_MODE=sheets
# ID dari URL https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=
# ID dari URL https://drive.google.com/drive/folders/<ID>
# (kosong = berkas disimpan di disk server, folder UPLOAD_DIR)
GOOGLE_DRIVE_FOLDER_ID=

# --- Pilih SALAH SATU cara login Google ---------------------------------------
# Cara A (disarankan untuk Gmail biasa): OAuth akun pengurus RT -> npm run google:auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Cara B: Service Account (upload Drive hanya jalan di Shared Drive / Google Workspace)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Jeda tulis ke spreadsheet setelah perubahan (ms) & interval cek edit manual di Sheets (ms)
SHEETS_FLUSH_DELAY_MS=1500
SHEETS_POLL_MS=30000
